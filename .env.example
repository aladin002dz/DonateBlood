# Copy this file to .env.local (development) and fill in real values.
# Never commit .env* files with real secrets.

# --- Database (Postgres via Neon) ---------------------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Better Auth ----------------------------------------------------------
# Read internally by the `better-auth` library (not referenced directly in
# app code). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public base URL used to build links in transactional emails
# (password reset, email verification).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OAuth providers --------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=onboarding@yourdomain.com

# --- Admin bootstrap script (scripts/make-admin.ts) --------------------
# Email of the user to promote to the `admin` role. Not read at runtime.
TARGET_EMAIL=

# --- Testing ------------------------------------------------------------
# Optional: point unit/integration tests at a separate database instead of
# DATABASE_URL (see tests/db-setup.ts).
TEST_DATABASE_URL=

# Credentials used by Playwright's auth.setup.ts to log in as a seeded
# test user before running the authenticated e2e specs.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Base URL Playwright runs e2e specs against (defaults to
# http://localhost:3000 if unset).
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
